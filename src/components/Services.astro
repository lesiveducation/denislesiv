---
const plans=[
  {name:'Мини-сайт',price:'7 900 ₽',note:'Для быстрого старта',features:['1–3 смысловых экрана','Адаптивная вёрстка','Контакты и целевое действие','1 круг правок']},
  {name:'Лендинг',price:'18 900 ₽',note:'Для услуги или продукта',featured:true,features:['Анализ аудитории и предложения','До 8 смысловых блоков','Тексты, дизайн и адаптив','Форма заявки и аналитика','2 круга правок']},
  {name:'Бизнес-сайт',price:'34 900 ₽',note:'До 5 страниц',features:['Структура под несколько услуг','Тексты и дизайн-система','Формы, базовое SEO и аналитика','Подготовка к расширению','2 круга правок']}
];
---
<section class="section section-dark" id="services"><div class="container"><div class="section-head"><span class="eyebrow">Услуги и стоимость</span><h2>Понятный объём работ вместо цены «от и до»</h2><p>Стартовые условия действуют для первых пяти коммерческих проектов в обмен на возможность оформить результат как кейс.</p></div>
<div class="plans">{plans.map(plan=><article class:list={['plan',{featured:plan.featured}]}>{plan.featured&&<span class="popular">Основной тариф</span>}<p class="plan-note">{plan.note}</p><h3>{plan.name}</h3><div class="price">{plan.price}</div><ul>{plan.features.map(item=><li>{item}</li>)}</ul><a href="https://t.me/iamdenislesiv" target="_blank" rel="noreferrer">Обсудить проект <span>↗</span></a></article>)}</div>
<div class="extras"><article><div><span class="service-code">BOT</span><h3>Telegram-боты</h3><p>Сбор заявок, запись, квалификация клиентов и автоматизация типовых диалогов.</p></div><strong>от 14 900 ₽</strong></article><article><div><span class="service-code">SKU</span><h3>Карточки товаров</h3><p>Обложка и слайды, которые последовательно раскрывают преимущества товара.</p></div><strong>от 3 500 ₽</strong></article></div><p class="fineprint">Домен, платный хостинг, CRM, AI API и сторонние сервисы оплачиваются отдельно. Точный состав фиксируется до старта.</p>
</div></section>
<style>#services{background-image:linear-gradient(180deg,rgba(5,16,23,.94),rgba(5,16,23,.87)),url('/images/commerce-code-services-v1.png');background-size:cover;background-position:center;background-attachment:fixed}.plans{display:grid;gap:1rem}.plan{position:relative;padding:clamp(1.5rem,3vw,2.2rem);border:1px solid rgba(255,255,255,.16);border-radius:1.25rem;background:rgba(10,27,36,.76);box-shadow:0 22px 65px rgba(0,0,0,.22);backdrop-filter:blur(14px)}.plan.featured{border-color:var(--teal);background:linear-gradient(155deg,rgba(18,63,65,.88),rgba(10,29,38,.82))}.popular{position:absolute;right:1.2rem;top:1.2rem;color:#072a25;background:var(--teal);padding:.35rem .65rem;border-radius:999px;font-size:.7rem;font-weight:800}.plan-note{font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}.plan h3{margin-bottom:.9rem}.price{font-size:clamp(2rem,4vw,3rem);font-weight:800;letter-spacing:-.06em}.plan ul{list-style:none;padding:0;margin:1.5rem 0 2rem}.plan li{padding:.55rem 0;border-bottom:1px solid rgba(255,255,255,.1);color:#c6d3d8;font-size:.9rem}.plan li::before{content:'✓';color:var(--teal);margin-right:.55rem}.plan a{color:var(--white);font-weight:800;text-decoration:none}.plan a span{color:var(--teal)}.extras{display:grid;gap:1rem;margin-top:1rem}.extras article{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;padding:1.5rem;border:1px solid rgba(255,255,255,.16);border-radius:1.25rem;background:rgba(8,24,32,.66);backdrop-filter:blur(12px)}.extras h3{margin:.6rem 0}.extras p{margin:0}.extras strong{white-space:nowrap;font-size:1.15rem}.service-code{color:var(--teal);font-size:.72rem;font-weight:800;letter-spacing:.12em}.fineprint{margin:1.5rem 0 0;font-size:.78rem}@media(min-width:850px){.plans{grid-template-columns:repeat(3,1fr)}.extras{grid-template-columns:1fr 1fr}}@media(max-width:900px){#services{background-attachment:scroll}}</style>
