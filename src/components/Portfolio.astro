---
const projects=[
 {title:'Переговорный контур',type:'Экспертная платформа',url:'https://lesiveducation.github.io/DLAI_Nego_contur/experts/',accent:'#14b8a6',text:'Сайт экспертного продукта: структура направлений, представление экспертов и связка с Telegram-ботом.',tags:['структура','тексты','бот']},
 {title:'Студия наращивания ресниц',type:'Beauty-лендинг',url:'https://lesiveducation.github.io/ZC_Lash01/',accent:'#e9a7b7',text:'Визуальный лендинг услуги с акцентом на доверие, результат и удобную запись.',tags:['структура','дизайн','запись']},
 {title:'Сайт психолога',type:'Сайт эксперта',url:'https://lesiveducation.github.io/ZC_Psycho/',accent:'#d8a65e',text:'Спокойная экспертная подача, последовательное раскрытие подхода и работа с сомнениями клиента.',tags:['тексты','дизайн','форма']},
 {title:'Ремонт квартир',type:'Локальный бизнес',url:'https://lesiveducation.github.io/ZC_Remont01/',accent:'#6ca6c8',text:'Сервисный лендинг с понятным перечнем работ, аргументами и быстрым обращением.',tags:['структура','тексты','форма']},
 {title:'Сайт мероприятия',type:'Сайт мероприятия',url:'https://lesiveducation.github.io/ZC_Event01/',accent:'#9b89cf',text:'Эмоциональная подача события, программа и сценарий перехода к регистрации.',tags:['структура','дизайн','регистрация']},
 {title:'NegoContur Bot',type:'Telegram-бот',url:'https://t.me/NegoContur_bot',accent:'#45aee4',text:'Рабочий бот как точка входа в экспертный продукт и пример диалогового интерфейса.',tags:['бот','сценарий','интеграция']}
];
---
<section class="section" id="portfolio"><div class="container"><div class="section-head"><span class="eyebrow">Портфолио</span><h2>Проекты, на которых отработан подход</h2><p>Пока это демонстрационные и учебные работы. Они подтверждают навыки структуры, текста, дизайна и реализации, но не приписывают себе бизнес-результаты клиентов.</p></div><div class="projects">{projects.map((p,i)=><a class="project" href={p.url} target="_blank" rel="noreferrer" style={`--accent:${p.accent}`}><div class="project-top"><span>0{i+1}</span><span class="tag">Демонстрационный проект</span></div><div class="visual"><span>{p.title.substring(0,2).toUpperCase()}</span></div><p class="project-type">{p.type}</p><h3>{p.title}</h3><p>{p.text}</p><div class="project-meta"><div>{p.tags.map(tag=><span>{tag}</span>)}</div></div><strong>Открыть проект ↗</strong></a>)}</div></div></section>
<style>.projects{display:grid;gap:1rem}.project{display:flex;flex-direction:column;padding:1.25rem;border:1px solid var(--line);border-radius:1.25rem;background:rgba(255,255,255,.72);text-decoration:none;transition:.25s}.project:hover{transform:translateY(-5px);box-shadow:0 22px 50px rgba(18,37,46,.09)}.project-top{display:flex;justify-content:space-between;gap:.5rem;color:var(--muted);font-size:.75rem}.visual{display:grid;place-content:center;height:170px;margin:1.2rem 0;border-radius:.9rem;background:color-mix(in srgb,var(--accent) 18%,#eef3f4);overflow:hidden}.visual span{display:grid;place-content:center;width:94px;height:94px;border-radius:50%;background:var(--accent);color:#fff;font-size:2rem;font-weight:800;letter-spacing:-.08em;box-shadow:16px 16px 0 color-mix(in srgb,var(--accent) 38%,transparent)}.project-type{margin-bottom:.45rem;color:var(--teal-dark);font-size:.76rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.project h3{margin-bottom:.7rem}.project>p:not(.project-type){font-size:.9rem}.project-meta{display:flex;align-items:flex-end;justify-content:space-between;gap:.75rem;margin:.2rem 0 .8rem}.project-meta div{display:flex;flex-wrap:wrap;gap:.35rem}.project-meta span{padding:.25rem .45rem;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:.65rem}.project-meta small{white-space:nowrap;color:var(--muted)}.project strong{margin-top:auto;padding-top:.6rem;font-size:.84rem}@media(min-width:700px){.projects{grid-template-columns:1fr 1fr}}@media(min-width:1040px){.projects{grid-template-columns:repeat(3,1fr)}}</style>
<style>#portfolio{background-image:linear-gradient(90deg,rgba(244,247,247,.97),rgba(244,247,247,.90)),url('/images/commerce-code-services-v1.png');background-size:cover;background-position:center}#portfolio::before{content:'// ideas → interface → action';position:absolute;left:2vw;bottom:1rem;color:rgba(12,24,32,.07);font:700 clamp(1rem,2vw,1.8rem)/1 var(--font);letter-spacing:.02em}.project{border-color:rgba(12,24,32,.12);background:rgba(255,255,255,.78);backdrop-filter:blur(12px)}.visual{position:relative;background:linear-gradient(145deg,color-mix(in srgb,var(--accent) 24%,#10242d),#09171e)}.visual::after{content:'</>';position:absolute;right:1rem;bottom:.55rem;color:rgba(255,255,255,.22);font-size:1.1rem;font-weight:800}</style>
