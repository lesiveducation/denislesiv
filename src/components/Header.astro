<header class="header"><div class="container header-inner">
  <a class="brand" href="#top" aria-label="Денис Лесив — на главную"><img src="/images/brand/dl-logo-horizontal.svg" alt="" width="700" height="260" /></a>
  <button class="menu-button" aria-expanded="false" aria-controls="site-nav"><i></i><i></i><i></i><span class="sr-only">Меню</span></button>
  <nav id="site-nav" class="nav" aria-label="Основная навигация"><a href="#services">Услуги</a><a href="#portfolio">Проекты</a><a href="#about">Опыт</a><a href="#process">Процесс</a><a href="/brief">Бриф</a><a class="nav-cta" href="https://t.me/iamdenislesiv" target="_blank" rel="noreferrer">Обсудить задачу</a></nav>
</div></header>
<script>const b=document.querySelector('.menu-button'),n=document.querySelector('.nav');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('is-open',!o)});n?.querySelectorAll('a').forEach(l=>l.addEventListener('click',()=>{b?.setAttribute('aria-expanded','false');n?.classList.remove('is-open')}));</script>
<style>.header{position:sticky;top:0;z-index:20;background:rgba(244,247,247,.88);border-bottom:1px solid rgba(12,24,32,.08);backdrop-filter:blur(16px)}.header-inner{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:1rem}.brand{display:block;width:clamp(148px,18vw,190px);text-decoration:none}.brand img{display:block;width:100%;height:auto}.menu-button{width:44px;height:44px;border:0;border-radius:50%;background:var(--ink);display:grid;place-content:center;gap:4px}.menu-button i{display:block;width:19px;height:2px;background:#fff}.nav{display:none;position:absolute;top:76px;left:0;right:0;padding:1.2rem 1rem 1.5rem;background:var(--paper);border-bottom:1px solid var(--line)}.nav.is-open{display:grid;gap:.2rem}.nav a{padding:.75rem;text-decoration:none;font-weight:700}.nav-cta{color:var(--teal-dark)}@media(min-width:900px){.menu-button{display:none}.nav{position:static;display:flex;align-items:center;padding:0;background:transparent;border:0;gap:.35rem}.nav a{padding:.5rem .7rem;font-size:.86rem}.nav-cta{margin-left:.55rem;border-radius:999px;background:var(--ink);color:#fff!important;padding:.7rem 1rem!important}}</style>
