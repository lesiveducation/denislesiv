---
const steps=[['01','Разбираемся','Обсуждаем продукт, аудиторию, задачу и критерий готового результата.'],['02','Фиксируем решение','Согласуем структуру, функциональность, сроки, стоимость и границы проекта.'],['03','Собираю прототип','Показываю логику и тексты до того, как детали дизайна станут дорогими в переделке.'],['04','Разрабатываю','Собираю адаптивную версию, подключаю формы и необходимые сервисы.'],['05','Запускаем','Проверяем сценарии, публикуем и фиксируем дальнейшие шаги без зависимости от исполнителя.']];
---
<section class="section section-dark" id="process"><div class="container"><div class="section-head"><span class="eyebrow">Как строится работа</span><h2>Сначала логика. Затем оформление и код.</h2></div><div class="steps">{steps.map(([number,title,text])=><article><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section>
<style>#process{background-image:linear-gradient(90deg,rgba(5,16,23,.96),rgba(5,16,23,.87)),url('/denislesiv/images/commerce-code-process-v1.png');background-size:cover;background-position:center}.steps{padding:0 1.2rem;border:1px solid rgba(255,255,255,.14);border-radius:1.25rem;background:rgba(6,20,28,.66);backdrop-filter:blur(14px)}.steps article{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1.65rem 0;border-bottom:1px solid rgba(255,255,255,.14)}.steps article:last-child{border-bottom:0}.steps>article>span{color:var(--teal);font-weight:800}.steps h3,.steps p{margin:0}.steps p{max-width:680px;margin-top:.55rem}@media(min-width:760px){.steps{padding-inline:2rem}.steps article{grid-template-columns:6rem 1fr}.steps article div{display:grid;grid-template-columns:15rem 1fr;gap:1rem}.steps p{margin:0}}</style>
